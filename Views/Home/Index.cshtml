@{
    ViewData["Title"] = "Send Digital Greeting Cards";
}

<!-- Hero Section -->
<header class="hero text-center d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <span class="badge bg-light text-accent rounded-pill mb-3 px-3 py-2 shadow-sm border">#1 E-Greeting Platform</span>
                <h1 class="display-4 fw-bold mb-4">Make Someone's Day Special with Digital Cards</h1>
                <p class="lead text-muted mb-5">Create, customize, and send beautiful animated greeting cards for every occasion. Join thousands of happy users today.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="register.html" class="btn btn-primary btn-lg px-5">Get Started Free</a>
                    <a href="subscribe.html" class="btn btn-outline-dark btn-lg px-5">View Pricing</a>
                </div>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-md-12">
                <img src="https://placehold.co/1000x400?text=Hero+Banner+Mockup" alt="Dashboard Preview" class="img-fluid rounded-4 shadow-lg border">
            </div>
        </div>
    </div>
</header>

<!-- Categories Section -->
<section class="py-5 bg-white">
    <div class="container py-5">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="fw-bold mb-3">Browse by Occasion</h2>
                <p class="text-muted">Choose from our wide range of professionally designed templates.</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <a href="categories/birthday.html" class="card h-100 text-center p-4 shadow-hover border-0 bg-light">
                    <div class="card-body">
                        <div class="display-5 text-accent mb-3"><i class="fas fa-birthday-cake"></i></div>
                        <h5 class="fw-bold text-dark">Birthday</h5>
                        <p class="text-muted small">100+ Templates</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="categories/wedding.html" class="card h-100 text-center p-4 shadow-hover border-0 bg-light">
                    <div class="card-body">
                        <div class="display-5 text-accent mb-3"><i class="fas fa-ring"></i></div>
                        <h5 class="fw-bold text-dark">Wedding</h5>
                        <p class="text-muted small">50+ Templates</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="categories/newyear.html" class="card h-100 text-center p-4 shadow-hover border-0 bg-light">
                    <div class="card-body">
                        <div class="display-5 text-accent mb-3"><i class="fas fa-glass-cheers"></i></div>
                        <h5 class="fw-bold text-dark">New Year</h5>
                        <p class="text-muted small">80+ Templates</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="categories/festivals.html" class="card h-100 text-center p-4 shadow-hover border-0 bg-light">
                    <div class="card-body">
                        <div class="display-5 text-accent mb-3"><i class="fas fa-star"></i></div>
                        <h5 class="fw-bold text-dark">Festivals</h5>
                        <p class="text-muted small">200+ Templates</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Featured Templates Section -->
<section class="py-5 bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold">Featured Templates</h2>
                <p class="text-muted mb-0">Popular picks from our community</p>
            </div>
            <a href="categories/birthday.html" class="btn btn-link text-accent fw-bold text-decoration-none">View All <i class="fas fa-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-4">
            <!-- Template Card 1 -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <img src="https://placehold.co/600x400?text=Birthday+Card" class="card-img-top" alt="Card Template">
                    <div class="card-body">
                        <span class="badge bg-soft-primary text-primary mb-2">Birthday</span>
                        <h5 class="card-title fw-bold">Colorful Balloons</h5>
                        <p class="card-text text-muted small">A vibrant design perfect for friends and family.</p>
                        <a href="card-editor.html" class="btn btn-outline-primary w-100 mt-2">Customize <i class="fas fa-paint-brush ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Template Card 2 -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <img src="https://placehold.co/600x400?text=Wedding+Invite" class="card-img-top" alt="Card Template">
                    <div class="card-body">
                        <span class="badge bg-soft-primary text-primary mb-2">Wedding</span>
                        <h5 class="card-title fw-bold">Elegant Floral</h5>
                        <p class="card-text text-muted small">Sophisticated floral patterns for your special day.</p>
                        <a href="card-editor.html" class="btn btn-outline-primary w-100 mt-2">Customize <i class="fas fa-paint-brush ms-1"></i></a>
                    </div>
                </div>
            </div>
            <!-- Template Card 3 -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <img src="https://placehold.co/600x400?text=Christmas+Wishes" class="card-img-top" alt="Card Template">
                    <div class="card-body">
                        <span class="badge bg-soft-primary text-primary mb-2">Festival</span>
                        <h5 class="card-title fw-bold">Cozy Winter</h5>
                        <p class="card-text text-muted small">Warm wishes for the holiday season.</p>
                        <a href="card-editor.html" class="btn btn-outline-primary w-100 mt-2">Customize <i class="fas fa-paint-brush ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 bg-white">
    <div class="container py-5 text-center">
        <div class="bg-accent text-white rounded-card p-5 shadow-lg position-relative overflow-hidden">
            <div class="position-relative z-1">
                <h2 class="fw-bold mb-3 text-white">Ready to Send Your First Card?</h2>
                <p class="lead mb-4 op-8">Join thousands of users sharing happiness every day.</p>
                <a href="register.html" class="btn btn-light btn-lg text-accent fw-bold px-5 shadow-sm">Create Free Account</a>
            </div>
        </div>
    </div>
</section>
