<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* <title>@ViewData["Title"] - E_Greetings</title> *@

    <title>@ViewData["Title"] - E-Greetings</title>

    @* <title>E-Greetings - Send Digital Greeting Cards</title> *@
    <!-- Bootstrap 5 CSS -->

    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> *@

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_Greetings.styles.css" asp-append-version="true" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    @* <link rel="stylesheet" href="assets/css/style.css"> *@
</head>
<body>

    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="index.html">
                <i class="fas fa-paper-plane text-accent me-2"></i>E-Greetings
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="home" asp-action="index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="categories/birthday.html">Birthday</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="categories/wedding.html">Wedding</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="categories/newyear.html">New Year</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Festivals
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="categories/festivals.html">Christmas</a></li>
                            <li><a class="dropdown-item" href="categories/festivals.html">Diwali</a></li>
                            <li><a class="dropdown-item" href="categories/festivals.html">Eid</a></li>
                            <li><a class="dropdown-item" href="categories/festivals.html">View All</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="subscribe.html">Subscribe</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="feedback.html">Feedback</a>
                    </li>
                </ul>
                <div class="d-flex">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary me-2">Login</a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-primary">Register</a>
                </div>
            </div>
        </div>
    </nav>
    @* <div class="container">
        <main role="main" class="pb-3"> *@
            @RenderBody()
    @*     </main>
    </div> *@

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <a href="index.html" class="d-block mb-3 text-decoration-none">
                        <h4 class="fw-bold text-dark"><i class="fas fa-paper-plane text-accent me-2"></i>E-Greetings</h4>
                    </a>
                    <p class="text-muted">Making the world a happier place, one digital card at a time. The best platform for managing and sending e-greetings.</p>
                    <div class="d-flex mt-4">
                        <a href="#" class="social-icon text-muted"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon text-muted"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon text-muted"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-icon text-muted"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-md-2 mb-4">
                    <h5 class="fw-bold">Company</h5>
                    <ul class="list-unstyled text-muted">
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Press</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h5 class="fw-bold">Resources</h5>
                    <ul class="list-unstyled text-muted">
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Tutorials</a></li>
                        <li><a href="#">Templates</a></li>
                        <li><a href="#">API</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">Contact Us</h5>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2 text-accent"></i> 123 Greeting St, Tech City, USA</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2 text-accent"></i> support@egreetings.com</li>
                        <li class="mb-2"><i class="fas fa-phone me-2 text-accent"></i> +1 (555) 123-4567</li>
                    </ul>
                </div>
            </div>
            <div class="row mt-4 pt-4 border-top">
                <div class="col-md-6 text-center text-md-start">
                    <p class="text-muted small mb-0">&copy; 2025 E-Greetings. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <ul class="list-inline mb-0 small text-muted">
                        <li class="list-inline-item"><a href="#">Privacy Policy</a></li>
                        <li class="list-inline-item ms-3"><a href="#">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@
    @* <script src="assets/js/main.js"></script> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

    
